<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#32b1c3">
    <title>Crossroads Professional Counseling</title>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body style="font-family:'Open Sans',sans-serif;background:#e8f0f2;margin:0;min-height:100vh;display:block;">
    <div class="topbar" style="position:sticky;top:0;z-index:10;">
      <span class="topbar-title" id="topbar-title">CROSSROADS</span>
    </div>

    <div style="padding:20px;">
      <%= tag.div(flash[:alert], style: "color:#c0392b;margin-bottom:16px;") if flash[:alert] %>
      <%= tag.div(flash[:notice], style: "color:#27ae60;margin-bottom:16px;") if flash[:notice] %>

      <%= yield %>
    </div>
  </body>
</html>
