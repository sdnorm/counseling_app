<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="#32b1c3">
    <title>Crossroads Professional Counseling</title>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body data-controller="sync navigation">
    <div id="app-root">
      <div class="topbar">
        <span class="topbar-title" id="topbar-title">CROSSROADS</span>
      </div>
      <div id="flash-container"></div>

      <% if authenticated? %>
      <!-- Passphrase unlock overlay -->
      <!-- Top-anchored (not centered) so the input stays above the iOS keyboard;
           centering it makes Safari pan the whole page up and it can stick there. -->
      <div id="unlock-overlay" style="position:absolute;top:0;left:0;right:0;bottom:0;background:var(--bg);z-index:100;padding:calc(10vh + env(safe-area-inset-top)) 20px 20px;display:flex;flex-direction:column;align-items:center;overflow-y:auto;">
        <div style="max-width:320px;width:100%;">
          <h2 style="text-align:center;margin-bottom:8px;">Unlock Your Data</h2>
          <p class="subtitle" style="text-align:center;margin-bottom:20px;">Your passphrase decrypts your journal, emotions, and gratitude entries. It never leaves this device.</p>
          <div class="card">
            <label class="lbl">Your Passphrase</label>
            <input type="password" id="unlock-passphrase" placeholder="Enter your passphrase" style="margin-bottom:12px;" />
            <button class="btn" id="unlock-btn" style="width:100%;">Unlock</button>
            <p id="unlock-first-time" style="color:var(--deep);font-size:12px;margin-top:8px;display:none;">First time? Any passphrase works. Write it down — it cannot be recovered.</p>
            <p id="unlock-error" style="color:#c0392b;font-size:12px;margin-top:8px;display:none;">Incorrect passphrase. Please try again.</p>
          </div>
          <p style="text-align:center;font-size:11px;color:var(--lt-brown);margin-top:16px;">
            Forgot your passphrase? Your data cannot be recovered. Contact your counselor for a new account.
          </p>
        </div>
      </div>
      <% end %>

      <div class="content" id="main-content">
        <%= yield %>
      </div>
      <nav class="bottom-nav" id="bottom-nav">
        <button class="nav-btn active" data-id="home" data-action="click->navigation#go">
          <span class="nav-icon">🏠</span>
          <span class="nav-label">Home</span>
        </button>
        <button class="nav-btn" data-id="schedule" data-action="click->navigation#go">
          <span class="nav-icon">🗓️</span>
          <span class="nav-label">Schedule</span>
        </button>
        <button class="nav-btn" data-id="more" data-action="click->navigation#toggleMore">
          <span class="nav-icon">⋯</span>
          <span class="nav-label">More</span>
        </button>
      </nav>
    </div>
  </body>
</html>
