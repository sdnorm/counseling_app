<div data-controller="emotions">
  <h2>Emotions</h2>
  <p class="subtitle">Select what you're feeling right now.</p>

  <div class="card">
    <div class="emotion-grid">
      <button class="btn btn-o emotion-btn" data-action="click->emotions#toggle" data-emotion="Joy"><span class="emoji">😊</span><span class="name">Joy</span></button>
      <button class="btn btn-o emotion-btn" data-action="click->emotions#toggle" data-emotion="Sadness"><span class="emoji">😢</span><span class="name">Sadness</span></button>
      <button class="btn btn-o emotion-btn" data-action="click->emotions#toggle" data-emotion="Anger"><span class="emoji">😠</span><span class="name">Anger</span></button>
      <button class="btn btn-o emotion-btn" data-action="click->emotions#toggle" data-emotion="Fear"><span class="emoji">😨</span><span class="name">Fear</span></button>
      <button class="btn btn-o emotion-btn" data-action="click->emotions#toggle" data-emotion="Surprise"><span class="emoji">😮</span><span class="name">Surprise</span></button>
      <button class="btn btn-o emotion-btn" data-action="click->emotions#toggle" data-emotion="Disgust"><span class="emoji">🤢</span><span class="name">Disgust</span></button>
    </div>

    <div data-emotions-target="details" style="display:none;">
      <label class="lbl">More specific feelings</label>
      <div id="emotion-children" style="display:flex;flex-wrap:wrap;gap:6px;"></div>

      <label class="lbl">I feel this about...</label>
      <input type="text" data-emotions-target="about" placeholder="a situation, person, or event (optional)" />

      <label class="lbl">...because</label>
      <input type="text" data-emotions-target="because" placeholder="what's behind the feeling? (optional)" />
    </div>

    <div style="display:flex;gap:8px;margin-top:10px;">
      <button class="btn" data-action="click->emotions#save">Save Snapshot</button>
      <button class="btn btn-o" data-action="click->emotions#clear">Clear</button>
    </div>
  </div>

  <div data-emotions-target="log">
    <!-- Populated by JS -->
  </div>
</div>
