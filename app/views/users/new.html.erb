<div class="auth-screen">
  <h2>Create Account</h2>
  <p class="subtitle">You'll need an invite code from your counselor.</p>

  <%= tag.div(flash[:alert], class: "form-error") if flash[:alert] %>

  <%= form_with model: @user, url: users_path do |f| %>
    <div class="field">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, autofocus: true, autocomplete: "email",
            placeholder: "you@example.com" %>
    </div>

    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password",
            placeholder: "At least #{User::MINIMUM_PASSWORD_LENGTH} characters", maxlength: 72 %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "Confirm password" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
            placeholder: "Repeat your password", maxlength: 72 %>
    </div>

    <div class="field">
      <%= f.label :invite_code, "Invite Code" %>
      <%= text_field_tag :"user[invite_code]", params[:code].presence, placeholder: "8-character code" %>
    </div>

    <div class="actions">
      <%= f.submit "Sign Up", class: "btn" %>
    </div>
  <% end %>

  <p class="auth-alt">
    Already have an account? <%= link_to "Sign in", new_session_path %>
    or <%= link_to "reset your password", new_password_path %>
  </p>
</div>
