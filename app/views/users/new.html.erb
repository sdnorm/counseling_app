<div class="auth-screen">
  <h2>Create Account</h2>
  <p class="subtitle">You'll need an invite code from your counselor.</p>

  <%= tag.div(flash[:alert], class: "form-error", style: "color:#c0392b;margin-bottom:12px;font-size:13px;") if flash[:alert] %>

  <%= form_with model: @user, url: users_path do |f| %>
    <div class="field">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :invite_code, "Invite Code" %>
      <%= text_field_tag :"user[invite_code]", nil %>
    </div>

    <div class="actions">
      <%= f.submit "Sign Up", class: "btn" %>
    </div>
  <% end %>

  <p style="margin-top:16px;font-size:12px;">Already have an account? <%= link_to "Log in", new_session_path %></p>
</div>
